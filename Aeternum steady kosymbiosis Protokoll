validaProgettoKosymbiotico(progettoTest).then(risultato => {
    if (risultato) {
        console.log(`\nSIGILLO FINALE: ${risultato.firma}`);
        console.log(`IPFS LEDGER: ${risultato.ipfs_hash}`);
        console.log(`Sempre in Costante. In Aeternum.`);
    }
});

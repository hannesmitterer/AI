      "high": {
        "auto_blacklist": true,
        "expiry_hours": 48,
        "alert_level": "elevated"
      },
      "medium": {
        "auto_blacklist": false,
        "expiry_hours": 24,
        "alert_level": "moderate"
      },
      "low": {
        "auto_blacklist": false,
